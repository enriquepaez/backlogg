meta {
  name: Edit movie
  type: http
  seq: 19
}

patch {
  url: {{baseUrl}}/v1/admin/movie/some-movie-slug
  body: json
  auth: none
}

headers {
  X-API-Key: {{adminApiKey}}
}

body:json {
  {
    "title": "Manually Corrected Title",
    "poster_url": "https://example.com/poster.jpg"
  }
}

tests {
  test("status 200 or 404", function() {
    expect([200, 404]).to.include(res.status);
  });
}

docs {
  Manually edit a subset of a movie's fields. Every field sent here is
  persisted AND added to the item's locked_fields, so the next nightly sync
  leaves it untouched. Editable fields for movie: title, poster_url,
  release_date, genres. Set {slug} to a real movie slug to get 200.
}
