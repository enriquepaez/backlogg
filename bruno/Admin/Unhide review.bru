meta {
  name: Unhide review
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/admin/reviews/1/unhide
  body: none
  auth: none
}

headers {
  X-API-Key: {{adminApiKey}}
}

tests {
  test("status 200 or 404", function() {
    expect([200, 404]).to.include(res.status);
  });
}

docs {
  Restore a previously hidden review. Idempotent. 404 if the review does not
  exist, 401 without a valid X-API-Key.
}
