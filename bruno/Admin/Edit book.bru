meta {
  name: Edit book
  type: http
  seq: 24
}

patch {
  url: {{baseUrl}}/v1/admin/book/some-book-slug
  body: json
  auth: none
}

headers {
  X-API-Key: {{adminApiKey}}
}

body:json {
  {
    "title": "Manually Corrected Title",
    "first_publish_date": "1965-08-01"
  }
}

tests {
  test("status 200 or 404", function() {
    expect([200, 404]).to.include(res.status);
  });
}

docs {
  Manually edit a subset of a book's fields. Every field sent here is
  persisted AND added to the item's locked_fields, so the next nightly sync
  leaves it untouched. Editable fields for book: title, poster_url,
  first_publish_date, genres. Set {slug} to a real book slug to get 200.
}
