meta {
  name: Unban user
  type: http
  seq: 12
}

post {
  url: {{baseUrl}}/admin/users/someuser/unban
  body: none
  auth: none
}

headers {
  X-API-Key: {{adminApiKey}}
}

tests {
  test("status 200 or 404", function() {
    expect([200, 404]).to.include(res.status);
  });
}

docs {
  Lift a ban: the user can log in again and their reviews become visible once
  more. Idempotent. 404 if the user does not exist, 401 without a valid
  X-API-Key.
}
