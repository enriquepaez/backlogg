meta {
  name: Edit game
  type: http
  seq: 25
}

patch {
  url: {{baseUrl}}/v1/admin/game/some-game-slug
  body: json
  auth: none
}

headers {
  X-API-Key: {{adminApiKey}}
}

body:json {
  {
    "title": "Manually Corrected Title",
    "release_date": "2015-05-19"
  }
}

tests {
  test("status 200 or 404", function() {
    expect([200, 404]).to.include(res.status);
  });
}

docs {
  Manually edit a subset of a game's fields. Every field sent here is
  persisted AND added to the item's locked_fields, so the next nightly sync
  leaves it untouched. Editable fields for game: title, poster_url,
  release_date, genres. Set {slug} to a real game slug to get 200.
}
