meta {
  name: Ban user
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/v1/admin/users/someuser/ban
  body: none
  auth: none
}

headers {
  X-API-Key: {{adminApiKey}}
}

tests {
  test("status 200 or 404", function() {
    expect([200, 404]).to.include(res.status);
  });
}

docs {
  Ban a user: they can no longer log in or refresh (both 401), and all of their
  reviews become invisible (excluded from listings, feed and aggregates).
  Idempotent. 404 if the user does not exist, 401 without a valid X-API-Key.
  Set {username} to a real user to get 200.
}
