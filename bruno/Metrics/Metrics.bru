meta {
  name: Metrics
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/metrics
  body: none
  auth: none
}

tests {
  test("returns 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("uses the Prometheus exposition content type", function() {
    expect(res.getHeader("content-type")).to.include("text/plain; version=0.0.4");
  });
  test("exposes the key metric families", function() {
    expect(res.getBody()).to.include("http_requests_total");
    expect(res.getBody()).to.include("http_request_duration_seconds");
  });
}
