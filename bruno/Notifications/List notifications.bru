meta {
  name: List notifications
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/v1/notifications
  body: none
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

vars:post-response {
  notificationId: res.body.items[0].id
}

tests {
  test("status 200", function() {
    expect(res.status).to.equal(200);
  });

  test("paginated list", function() {
    expect(res.body).to.have.property("items");
    expect(res.body).to.have.property("total");
  });
}

docs {
  Reverse-chronological notifications for the authenticated user. Each entry
  includes the actor (username, display_name, avatar_url) and target info.
  Captures notificationId (the new_follower notification generated by "Follow
  as notif actor") for the "Delete notification" request below.
}
