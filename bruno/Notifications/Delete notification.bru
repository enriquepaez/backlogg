meta {
  name: Delete notification
  type: http
  seq: 7
}

delete {
  url: {{baseUrl}}/v1/notifications/{{notificationId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

tests {
  test("status 204", function() {
    expect(res.status).to.equal(204);
  });
}

docs {
  Deletes the real new_follower notification generated by "Follow as notif
  actor" and captured as {{notificationId}} by "List notifications". Run the
  requests in this folder in seq order (1-7) so the id is populated before
  this request runs.
}
