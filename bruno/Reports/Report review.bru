meta {
  name: Report review
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/reviews/1/report
  body: json
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

body:json {
  {
    "reason": "spam"
  }
}

tests {
  test("status 201 or 200", function() {
    expect([200, 201]).to.include(res.status);
  });
}

docs {
  Report a review (a UserRating row) by its id. Idempotent per (reporter,
  review): the first report returns 201, a repeat by the same user returns 200
  with the existing report. Reporting a non-existent review returns 404; without
  a token, 401. ``reason`` is optional (send an empty body to omit it).
}
