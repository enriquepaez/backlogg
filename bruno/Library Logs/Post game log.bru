meta {
  name: Post game log
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/v1/games/the-witcher-3-wild-hunt/log
  body: json
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

body:json {
  {
    "rewatch": true
  }
}

tests {
  test("status 201", function() {
    expect(res.status).to.equal(201);
  });

  test("item_type is GAME", function() {
    expect(res.body.item_type).to.equal("GAME");
  });
}
