meta {
  name: Post movie log
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/v1/movies/oppenheimer-2023/log
  body: json
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

body:json {
  {
    "logged_on": "2024-05-01",
    "rewatch": true,
    "note": "Second watch, holds up"
  }
}

tests {
  test("status 201", function() {
    expect(res.status).to.equal(201);
  });

  test("created log fields", function() {
    expect(res.body.item_type).to.equal("MOVIE");
    expect(res.body.logged_on).to.equal("2024-05-01");
    expect(res.body.rewatch).to.equal(true);
  });
}
