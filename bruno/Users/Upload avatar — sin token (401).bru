meta {
  name: Upload avatar — sin token (401)
  type: http
  seq: 20
}

post {
  url: {{baseUrl}}/v1/users/me/avatar
  body: multipartForm
  auth: none
}

body:multipart-form {
  file: @file(./assets/test-avatar.png)
}

tests {
  test("status 401", function() {
    expect(res.status).to.equal(401);
  });
}
