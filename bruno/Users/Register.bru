meta {
  name: Register
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/v1/auth/register
  body: json
  auth: none
}

body:json {
  {
    "username": "bruno_tester",
    "email": "bruno_tester@example.com",
    "password": "testpass123"
  }
}

tests {
  test("status 201", function() {
    expect(res.status).to.equal(201);
  });

  test("no password in response", function() {
    expect(res.body).to.not.have.property("password");
    expect(res.body).to.not.have.property("password_hash");
  });
}
