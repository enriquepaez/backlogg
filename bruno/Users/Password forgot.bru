meta {
  name: Password forgot
  type: http
  seq: 15
}

post {
  url: {{baseUrl}}/v1/auth/password/forgot
  body: json
  auth: none
}

body:json {
  {
    "email": "bruno_tester@example.com"
  }
}

tests {
  test("status 202", function() {
    expect(res.status).to.equal(202);
  });
}

docs {
  Always returns 202, whether or not the email is registered (no enumeration).
  If registered, a reset token is emailed (or logged without SMTP_HOST);
  copy the token into "Password reset".
}
