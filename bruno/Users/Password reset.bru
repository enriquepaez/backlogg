meta {
  name: Password reset
  type: http
  seq: 16
}

post {
  url: {{baseUrl}}/auth/password/reset
  body: json
  auth: none
}

body:json {
  {
    "token": "paste-the-token-from-the-reset-link",
    "new_password": "brand-new-password"
  }
}

tests {
  test("status 200", function() {
    expect(res.status).to.equal(200);
  });
}

docs {
  Consumes the single-use reset token, changes password_hash and revokes every
  active refresh token for the user. An invalid/expired/already-used token
  returns 400.
}
