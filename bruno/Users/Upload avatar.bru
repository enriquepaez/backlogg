meta {
  name: Upload avatar
  type: http
  seq: 19
}

post {
  url: {{baseUrl}}/v1/users/me/avatar
  body: multipartForm
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

body:multipart-form {
  file: @file(./assets/test-avatar.png)
}

tests {
  test("status 200 (or 503 if R2 is not configured in this environment)", function() {
    expect([200, 503]).to.include(res.status);
  });
}
