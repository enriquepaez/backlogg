meta {
  name: Get recommendations
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/v1/recommendations
  body: none
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

tests {
  test("status 200", function() {
    expect(res.status).to.equal(200);
  });

  test("results array present", function() {
    expect(res.body).to.have.property("results");
  });
}

docs {
  Personalized suggestions from the caller's ratings (score >= 4) and library
  (completed/want). Falls back to trending/popular when there are no seeds.
  Each result carries a human-readable reason.
}
