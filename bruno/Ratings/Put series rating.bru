}

put {
  url: {{baseUrl}}/series/the-bear-2022/rating
  body: json
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

body:json {
  {
    "score": 4,
    "review_text": "Stressful but great."
  }
}

tests {
