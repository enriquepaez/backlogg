meta {
  name: Put movie rating — sin token (401)
  type: http
  seq: 2
}

put {
  url: {{baseUrl}}/v1/movies/oppenheimer-2023/rating
  body: json
  auth: none
}

body:json {
  {
    "score": 5,
    "review_text": null
  }
}

tests {
  test("status 401", function() {
    expect(res.status).to.equal(401);
  });
}
