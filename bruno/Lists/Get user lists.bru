meta {
  name: Get user lists
  type: http
  seq: 12
}

get {
  url: {{baseUrl}}/users/bruno_tester/lists
  body: none
  auth: none
}

tests {
  test("status 200", function() {
    expect(res.status).to.equal(200);
  });

  test("listing shape", function() {
    expect(res.body).to.have.property("lists");
    expect(res.body).to.have.property("total");
    if (res.body.lists.length > 0) {
      expect(res.body.lists[0]).to.have.property("slug");
      expect(res.body.lists[0]).to.have.property("item_count");
    }
  });
}
