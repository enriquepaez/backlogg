meta {
  name: Update list
  type: http
  seq: 5
}

patch {
  url: {{baseUrl}}/lists/best-sci-fi
  body: json
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

body:json {
  {
    "description": "updated description",
    "is_public": false
  }
}

tests {
  test("status 200", function() {
    expect(res.status).to.equal(200);
  });

  test("fields updated, slug unchanged", function() {
    expect(res.body.slug).to.equal("best-sci-fi");
    expect(res.body.is_public).to.equal(false);
    expect(res.body.description).to.equal("updated description");
  });
}
