meta {
  name: Add list item
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/v1/lists/best-sci-fi/items
  body: json
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

body:json {
  {
    "item_type": "movie",
    "slug": "fight-club-1999"
  }
}

tests {
  test("status 200", function() {
    expect(res.status).to.equal(200);
  });

  test("item appended to list", function() {
    expect(res.body).to.have.property("items");
    const found = res.body.items.find(function(i) {
      return i.item_type === "movie" && i.slug === "fight-club-1999";
    });
    expect(found).to.not.equal(undefined);
  });
}
