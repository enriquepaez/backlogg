meta {
  name: Get series by slug
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/series/the-bear-2022
  body: none
  auth: none
}

tests {
  test("status 200", function() {
    expect(res.status).to.equal(200);
  });

  test("credits field is an array", function() {
    expect(res.body.credits).to.be.an("array");
  });

  test("credits items have required fields", function() {
    if (res.body.credits.length > 0) {
      const c = res.body.credits[0];
      expect(c).to.have.property("person_name");
      expect(c).to.have.property("person_slug");
      expect(c).to.have.property("role");
      expect(c).to.have.property("billing_order");
    }
  });
}
