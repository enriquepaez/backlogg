# Origin of the backlogg backend, WITHOUT the /v1 prefix
# (the OpenAPI paths already include /v1). Server-only; never expose to the browser.
API_INTERNAL_URL=http://localhost:8000

# Public origin this app is served from. Used only as Next's `metadataBase`
# (set once in [locale]/layout.tsx's generateMetadata) so relative OG/Twitter
# image paths resolve to absolute URLs social crawlers can fetch (FE-45).
# Read only inside generateMetadata, a server-only export, so no NEXT_PUBLIC_
# prefix is needed. Optional — defaults to http://localhost:3000 (the dev
# server's own origin, FE-1) when unset; override in production with the
# real deployed origin.
# SITE_URL=http://localhost:3000

# Optional: override the httpOnly auth cookie names (defaults: bl_access / bl_refresh).
# AUTH_ACCESS_COOKIE=bl_access
# AUTH_REFRESH_COOKIE=bl_refresh

# Shared secret sent as X-API-Key to /v1/admin/* (FE-28). Must match the
# backend's ADMIN_API_KEY. Server-only; never expose to the browser. Leave
# unset to keep the admin section disabled (Route Handlers answer 503).
ADMIN_API_KEY=

# Public base user avatars are served from (FE-49) — the same value as the
# backend's own R2_PUBLIC_BASE_URL (root .env.example, backlogg/core/config.py),
# since `avatar_url` in API responses is already that base + object key. Named
# independently here rather than reusing "R2_*": this app only cares about the
# resolved public URL of the storage bucket, not that it happens to be R2/
# MinIO/Supabase behind the scenes. Read directly via `process.env` inside
# next.config.ts (which runs in Node at build/dev time, not through this
# file's src/lib/env.ts) to populate images.remotePatterns — no trailing
# slash, no NEXT_PUBLIC_ prefix needed since next.config.ts never ships to
# the client bundle. Leave unset to skip registering an avatar remotePattern
# (avatars simply won't be optimized until this is set, no build failure).
#
# Example — MinIO local (matches the backend's dev R2_PUBLIC_BASE_URL):
#   AVATAR_PUBLIC_BASE_URL=http://localhost:9000/avatars
# Example — Supabase Storage in prod (matches the backend's prod value):
#   AVATAR_PUBLIC_BASE_URL=https://<project-ref>.supabase.co/storage/v1/object/public/<bucket>
AVATAR_PUBLIC_BASE_URL=
