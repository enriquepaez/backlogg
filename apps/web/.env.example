# Origin of the backlogg backend, WITHOUT the /v1 prefix
# (the OpenAPI paths already include /v1). Server-only; never expose to the browser.
API_INTERNAL_URL=http://localhost:8000

# Public origin this app is served from. Used only as Next's `metadataBase`
# (set once in [locale]/layout.tsx's generateMetadata) so relative OG/Twitter
# image paths resolve to absolute URLs social crawlers can fetch (FE-45).
# Read only inside generateMetadata, a server-only export, so no NEXT_PUBLIC_
# prefix is needed. Optional — defaults to http://localhost:3000 (the dev
# server's own origin, FE-1) when unset; override in production with the
# real deployed origin.
# SITE_URL=http://localhost:3000

# Optional: override the httpOnly auth cookie names (defaults: bl_access / bl_refresh).
# AUTH_ACCESS_COOKIE=bl_access
# AUTH_REFRESH_COOKIE=bl_refresh

# Shared secret sent as X-API-Key to /v1/admin/* (FE-28). Must match the
# backend's ADMIN_API_KEY. Server-only; never expose to the browser. Leave
# unset to keep the admin section disabled (Route Handlers answer 503).
ADMIN_API_KEY=
