# Local dev DB from `docker compose up -d` (see docker-compose.yml).
# Production uses Neon, configured in Render — never point these at prod.
DATABASE_URL=postgresql+asyncpg://postgres:dev@localhost:5432/backlogg
TEST_DATABASE_URL=postgresql+asyncpg://postgres:dev@localhost:5432/backlogg_test

# Licencia gratuita solo para uso NO COMERCIAL: cobrar, poner publicidad o
# entrenar IA con sus datos exige licencia comercial (149 $/mes). Ver
# docs/external-apis.md antes de monetizar o de generar embeddings.
TMDB_API_KEY=

# IGDB vía Twitch. También solo uso no comercial (Twitch Developer Services
# Agreement); sus términos comerciales no publican precio.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# TMDB catalog definition (feature 86). The catalog is a quality threshold,
# not an item count: vote_count >= 25 yields 57.135 movies and 10.880 series
# (exact total_results measured against /discover on 2026-09-02). Per type so
# the two can be recalibrated independently; other measured thresholds are
# tabulated in docs/seeding-plan.md §2.1.
TMDB_SEED_MIN_VOTES_MOVIES=25
TMDB_SEED_MIN_VOTES_SERIES=25
# Release-year range the /discover enumeration slices over. 1874 is TMDB's
# oldest release year; leaving the end blank means "next year".
TMDB_SEED_START_YEAR=1874
# TMDB_SEED_END_YEAR=
# In-flight TMDB requests during seeding (enumeration pages and item
# hydration). TMDB documents ~50 req/s; 8 lands at ~32 (docs/seeding-plan.md §4).
TMDB_SEED_CONCURRENCY=8
# Conclusive hydration passes a seed target gets before it is retired from the
# work list as unlinkable. A failed request is not a pass, so a TMDB outage
# cannot retire a healthy target. This is what makes `pending` converge to 0 —
# and therefore what lets the last_synced_at refresh rotation run at all. The
# retired residue is reported separately as `stuck`. See docs/seeding-plan.md §3.
TMDB_SEED_MAX_ATTEMPTS=3

# TMDB incremental updates (feature 88). A release has no votes on the day it
# comes out, so the ids that arrive from TMDB's daily id export are gated on
# the release date instead: admitted when they are a recent or imminent
# release, not merely a new id. Everything older keeps entering the usual way,
# through the vote_count threshold, once it earns an audience.
TMDB_INCREMENTAL_MAX_AGE_DAYS=90
TMDB_INCREMENTAL_HORIZON_DAYS=180
# Days the last processed export may lag before the appearance diff is skipped
# for one run and the baseline is reset to today's file (reported, not silent).
TMDB_INCREMENTAL_MAX_EXPORT_GAP_DAYS=7
# Recent release years the promotion sweep re-enumerates through /discover, so
# items that cross vote_count >= 25 after the seeding still enter the catalog.
TMDB_PROMOTION_YEARS=10

# IGDB incremental updates (feature 88). IGDB answers both questions in its own
# query language (`where created_at > X` / `where updated_at > X`), so all it
# needs is a bound on the first run and a bound per run.
# Cold start with no watermark: ask for the last week, not for everything.
IGDB_INCREMENTAL_LOOKBACK_DAYS=7
# Ceiling per lane per run. IGDB caps a response at 500 games and allows 4
# req/s. Hitting the ceiling loses nothing: the query is sorted ascending and
# the watermark advances to the newest record actually seen.
IGDB_INCREMENTAL_MAX_ITEMS=2000

# Wikidata SPARQL dump (feature 79) — scripts/sync_wikidata.py, scheduled by
# .github/workflows/wikidata-sync.yml. No API key and no account: the endpoint
# (query.wikidata.org/sparql) is public and the data is CC0, so this layer
# costs nothing. All it needs is DATABASE_URL.
# Wall-clock ceiling per pass, in minutes. The job stops itself before the
# Actions timeout can kill it, keeping its cursor and its coverage report; a
# re-dispatch continues where it stopped. 0 disables the ceiling.
WIKIDATA_SYNC_TIME_BUDGET_MINUTES=300

# Semantic layer: embeddings + pgvector (feature 75) —
# scripts/generate_embeddings.py, scheduled by .github/workflows/embeddings.yml.
# No API key and no account either: the model is LOCAL and runs on the GitHub
# Actions runner, so this layer costs nothing but runner minutes. All it needs
# is DATABASE_URL. Never set on Render — the API serves /similar out of the
# HNSW index and never loads a model.
#
# The model. Multilingual is mandatory (synopses arrive in Spanish and in
# English) and 384 is its native width — nothing is truncated.
EMBEDDING_MODEL=intfloat/multilingual-e5-small
# E5 wants a task prefix; "query: " on both sides is what its model card
# prescribes for symmetric similarity, which is what /similar is.
EMBEDDING_TEXT_PREFIX="query: "
# Baked into the halfvec column by migration 0042. Changing it after migrating
# does NOT migrate anything — see docs/operations.md before touching it.
EMBEDDING_DIM=384
#
# The hard cap, and the reason this layer is a subset and not the catalog:
# Neon free is 512 MB per project, the full catalog is projected at 444-488 MB
# (issue #28), so there is ~80-120 MB of headroom.
#
# MEASURED, not estimated (2026-09-15, 35.215 real rows): 2.262 bytes per item,
# so 40.000 items in halfvec(384) cost 86-90 MB with the HNSW index. The
# planning estimate said ~67 MB; it was 30% low. 86-90 MB does fit in the
# headroom, but AT THE BOTTOM OF IT — not with room to spare. 100.000 items do
# not fit in any format.
#
# ⚠️ Before the first generation in production, measure the real headroom and
# size this knob to it: docs/operations.md § "Disco: la restricción que manda,
# medida" carries the pre-check and the rule of thumb
# (EMBEDDING_MAX_ITEMS ≈ (headroom_MB - 20) / 0,00225). Overrunning does not
# fail a test — it fails the nightly sync the day Neon refuses a write.
EMBEDDING_MAX_ITEMS=40000
# Per-type overrides. Left unset, the cap is split EQUALLY between the four
# types and any share a type cannot fill goes back to the others. Equal and not
# proportional on purpose: feature 80 needs depth in every type.
# EMBEDDING_MAX_ITEMS_MOVIES=
# EMBEDDING_MAX_ITEMS_SERIES=
# EMBEDDING_MAX_ITEMS_BOOKS=
# EMBEDDING_MAX_ITEMS_GAMES=
# Items per inference batch and per transaction.
EMBEDDING_BATCH_SIZE=256
# Wall-clock ceiling for the run, in minutes; the job stops itself instead of
# being killed by the Actions timeout. 0 disables it.
EMBEDDING_TIME_BUDGET_MINUTES=300

# The /similar ranker (feature 80). Serves GET /{type}/{slug}/similar out of the
# HNSW index above — no model, no external call, no extra dependency.
#
# THE SWITCH THAT DECIDES WHETHER /similar IS CROSS-TYPE AT ALL:
#
#   0  → the endpoint NEVER returns an item of another type. Not "reserves no
#        slots" — never: the index query itself is narrowed to the type of the
#        item in the URL.
#   N  → N of the 10 slots are RESERVED for other types (the ficha asks for 3).
#
# Those two are not the same thing, and the difference is not academic:
# reserving nothing still lets cosine hand back the other types whenever they
# genuinely win, which on the real dev catalog was 63% of the rows of a film's
# page — 7 of the 10 neighbours of The Return of the King.
#
# IT SHIPS AT 0 ON PURPOSE. apps/web/src/components/item-similar.tsx links every
# result to /{type-of-the-page}/{slug}, so ONE book among films is a 404 in
# production (issues #32, #33 and #36 were all that same shape) and Render
# deploys main on merge. The behaviour is implemented and tested at any value;
# what is deferred is switching it on. FE-67 sets this to 3 in the same PR that
# renders the type badge. item_type travels in every result either way, so the
# frontend already has what it needs to turn it on.
SIMILAR_CROSS_TYPE_QUOTA=0
# Diversification: each candidate is demoted (score * (1 - penalty)) for every
# group already taken above it — same franchise, or same author/director. Ten
# entries of one saga are not ten recommendations. 0 disables it.
SIMILAR_DIVERSITY_PENALTY=0.25
# Neighbours pulled from the index per result served. The ranker needs room to
# demote duplicates and to reach a fourth type.
SIMILAR_CANDIDATE_MULTIPLIER=6
# pgvector's HNSW candidate window for the queries NARROWED BY TYPE — the
# quota=0 one (anchor's own type) and the quota>0 one (the other three). Nothing
# else touches it. item_types is a POST-filter, so when the planner uses the
# HNSW index and the wanted type is a small share of it, the answer is not
# "fewer rows", it is ZERO rows. Measured on the dev catalog (94% games), 60
# neighbours asked: non-GAME of a game → 0 rows at 40 and at 200, 1 at 400, 60
# at 800 and at 1000; GAME of a game → 39 at 40, 60 from 200 up. A cliff, so
# this sits at pgvector's ceiling. Costs a few ms inside one index.
SIMILAR_FILTERED_EF_SEARCH=1000

# Open Library seed quality filter (feature 73). The language fragments of the
# query are constants in backlogg/books/constants.py; only these thresholds
# are tunable. Defaults are the live-calibrated values (16.959 english +
# 1.858 spanish works) documented in docs/external-apis.md.
# BOOKS_SEED_MIN_READINGLOG: minimum readinglog_count for the english stream.
# BOOKS_SEED_MIN_READINGLOG_ES: same for the spanish stream — the shelving
#   signal is ~10x weaker in spanish, so a shared floor would seed 0 works.
# BOOKS_SEED_MIN_PAGES: minimum number_of_pages_median; drops pamphlets.
# BOOKS_SEED_MIN_EDITIONS: minimum edition_count for the english stream. This
#   is the notoriety filter: it drops loose comic instalments and video-game
#   tie-ins (0-3 editions) while keeping canonical graphic novels (11-66).
# BOOKS_SEED_MIN_EDITIONS_ES: same for the spanish stream. 2 and not 3 on
#   purpose — Reina roja has exactly 2 editions.
BOOKS_SEED_MIN_READINGLOG=20
BOOKS_SEED_MIN_READINGLOG_ES=5
BOOKS_SEED_MIN_PAGES=100
BOOKS_SEED_MIN_EDITIONS=10
BOOKS_SEED_MIN_EDITIONS_ES=2

# Nightly sync slice. SYNC_SLICE_SIZE is the global fallback (200) and stays
# as-is; the four per-type overrides (feature 84) exist because the types have
# genuinely different needs — see docs/seeding-plan.md §2.3. Leave them unset
# to keep the current behaviour: an unset override falls back to
# SYNC_SLICE_SIZE, so this release changes nothing until they are filled in.
# Resolution order per job: explicit --slice-size argument (backfill script) ->
# SYNC_SLICE_SIZE_<TYPE> -> SYNC_SLICE_SIZE.
# Production targets for the seeding features (86-88), NOT applied by default:
#   SYNC_SLICE_SIZE_MOVIES=350  (57.135 movies re-synced inside TMDB's 6-month
#                                cache window = ~318/night, rounded up)
#   SYNC_SLICE_SIZE_SERIES=100  (10.880 series over 180 days = ~61/night)
SYNC_SLICE_SIZE=200
# SYNC_SLICE_SIZE_MOVIES=
# SYNC_SLICE_SIZE_SERIES=
# SYNC_SLICE_SIZE_BOOKS=
# SYNC_SLICE_SIZE_GAMES=

# How many items the batch write path (feature 84) writes per transaction.
# Bigger means fewer SQL round trips; smaller means less work to redo if a
# batch has to fall back to the per-item route.
#
# Upper bound — do NOT raise this past ~2.000 without reading the note in the
# docstring of backlogg/shared/bulk_load.py.  The batch route renders two
# lookup queries as `(source, external_id) IN ((?,?), ...)`, i.e. 2 bind
# parameters per key, and Postgres' wire protocol caps a statement at 32.767
# parameters.  At the ~7 credits/item this catalog averages that ceiling is
# hit around ~2.300 items per batch.  Crossing it does not corrupt anything:
# the batch raises and the caller reprocesses those items one by one — but
# that fallback is ~50x slower, and it is silent apart from a log line, so a
# too-large value turns a tuning knob into an invisible slowdown.
BULK_LOAD_BATCH_SIZE=500

SYNC_CRON=0 2 * * *

ADMIN_API_KEY=

# S3-compatible object storage, used for user avatar uploads
# (POST/DELETE /v1/users/me/avatar). Leave every R2_* var below empty in dev
# to get a controlled 503 instead of an unconfigured client failure.
#
# R2_ENDPOINT_URL selects the provider: empty -> real Cloudflare R2 (built
# from R2_ACCOUNT_ID, 10GB free tier, no egress fees); set -> any
# S3-compatible endpoint (MinIO in dev, Supabase Storage in prod). When
# R2_ENDPOINT_URL is set, R2_ACCOUNT_ID is not needed.
# R2_PUBLIC_BASE_URL is the public base objects are served from — no
# trailing slash.
R2_ENDPOINT_URL=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=

# Example — MinIO local (docker-compose.yml `minio` service), no card needed:
#   R2_ENDPOINT_URL=http://localhost:9000
#   R2_ACCESS_KEY_ID=minioadmin
#   R2_SECRET_ACCESS_KEY=minioadmin123
#   R2_BUCKET_NAME=avatars
#   R2_PUBLIC_BASE_URL=http://localhost:9000/avatars
#   (R2_ACCOUNT_ID not needed)
#
# Example — Supabase Storage in prod (S3-compatible, free tier, no card):
#   R2_ENDPOINT_URL=https://<project-ref>.supabase.co/storage/v1/s3
#   R2_ACCESS_KEY_ID=<S3 access key id, from Supabase Storage settings>
#   R2_SECRET_ACCESS_KEY=<S3 secret access key, from Supabase Storage settings>
#   R2_BUCKET_NAME=<your-supabase-bucket-name>
#   R2_PUBLIC_BASE_URL=https://<project-ref>.supabase.co/storage/v1/object/public/<bucket>
#   (R2_ACCOUNT_ID not needed)

JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# Account recovery (email verification + password reset).
# Leave SMTP_HOST empty in dev: the EmailSender logs the link instead of sending
# it. APP_BASE_URL is the public base used to build the email links.
# For Gmail testing: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_STARTTLS=true,
# SMTP_USERNAME/SMTP_FROM_EMAIL=<your-gmail>, SMTP_PASSWORD=<app-password> (2FA).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@backlogg.local
SMTP_STARTTLS=true
APP_BASE_URL=http://localhost:3000
EMAIL_VERIFY_EXPIRE_HOURS=24
PASSWORD_RESET_EXPIRE_HOURS=1

# Rate limiting — format "count/seconds" (e.g. 10/60 = 10 hits per 60s).
# RATE_LIMIT_AUTH: per-IP limit on POST /auth/login and /auth/register.
# RATE_LIMIT_SEARCH_FALLBACK: per-IP limit on the external fan-out of /search.
# RATE_LIMIT_DEFAULT: general-purpose bucket reusable by the limiter interface.
RATE_LIMIT_AUTH=10/60
RATE_LIMIT_DEFAULT=120/60
RATE_LIMIT_SEARCH_FALLBACK=20/60

# Observability — structured JSON logging + optional Sentry.
# LOG_LEVEL: root log level (DEBUG/INFO/WARNING/ERROR). Logs are emitted as JSON
#   lines with a request_id for correlation; sensitive fields are always redacted.
# SENTRY_DSN: leave empty to disable error tracking entirely (no overhead, the
#   sentry-sdk package is never even imported). Set it to enable Sentry.
LOG_LEVEL=INFO
SENTRY_DSN=

# Response caching — Cache-Control/ETag on reads + in-process TTL cache for the
# expensive /trending and /genres reads (all seconds).
# CACHE_CONTROL_DETAIL_MAX_AGE: max-age advertised for anonymous detail reads.
# CACHE_CONTROL_LISTING_MAX_AGE: max-age for catalog listings.
# CACHE_TTL_TRENDING / CACHE_TTL_GENRES: TTL of the in-process cache (behind a
#   swappable interface, movable to Redis) for those aggregate reads.
CACHE_CONTROL_DETAIL_MAX_AGE=300
CACHE_CONTROL_LISTING_MAX_AGE=60
CACHE_TTL_TRENDING=900
CACHE_TTL_GENRES=300

# Trending (feature 81) — /v1/trending is computed from the platform's own
# recent activity (activity_events + library_entries + user_ratings) with
# exponential time decay, no external fan-out.
# TRENDING_MIN_ACTIVITY: minimum number of activity gestures a content type
#   must have inside the period's window before its local ranking is served.
#   Evaluated **per type**, so books can rank locally while games still fall
#   back. Below the threshold the type falls back to the catalog's canonical
#   order (rating_internal DESC NULLS LAST, rating_external DESC NULLS LAST)
#   restricted to recent releases — 90 days for period=day, 365 for period=week.
# TRENDING_MIN_USERS: minimum number of DISTINCT users behind those gestures.
#   Second condition, evaluated together with TRENDING_MIN_ACTIVITY over the
#   same de-duplicated gestures: a lone account rating five different items
#   crosses the gesture count by itself, so "enough activity" also has to mean
#   "enough people". Both must hold or the type falls back to the catalog.
TRENDING_MIN_ACTIVITY=5
TRENDING_MIN_USERS=3
