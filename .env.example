# Local dev DB from `docker compose up -d` (see docker-compose.yml).
# Production uses Neon, configured in Render — never point these at prod.
DATABASE_URL=postgresql+asyncpg://postgres:dev@localhost:5432/backlogg
TEST_DATABASE_URL=postgresql+asyncpg://postgres:dev@localhost:5432/backlogg_test

TMDB_API_KEY=

TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

SEED_TOP_N_MOVIES=100
SEED_TOP_N_SERIES=100
SEED_TOP_N_BOOKS=100
SEED_TOP_N_GAMES=100

SYNC_CRON=0 2 * * *

ADMIN_API_KEY=

JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# Account recovery (email verification + password reset).
# Leave SMTP_HOST empty in dev: the EmailSender logs the link instead of sending
# it. APP_BASE_URL is the public base used to build the email links.
# For Gmail testing: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_STARTTLS=true,
# SMTP_USERNAME/SMTP_FROM_EMAIL=<your-gmail>, SMTP_PASSWORD=<app-password> (2FA).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@backlogg.local
SMTP_STARTTLS=true
APP_BASE_URL=http://localhost:8000
EMAIL_VERIFY_EXPIRE_HOURS=24
PASSWORD_RESET_EXPIRE_HOURS=1
