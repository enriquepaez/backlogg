# Local dev DB from `docker compose up -d` (see docker-compose.yml).
# Production uses Neon, configured in Render — never point these at prod.
DATABASE_URL=postgresql+asyncpg://postgres:dev@localhost:5432/backlogg
TEST_DATABASE_URL=postgresql+asyncpg://postgres:dev@localhost:5432/backlogg_test

# Licencia gratuita solo para uso NO COMERCIAL: cobrar, poner publicidad o
# entrenar IA con sus datos exige licencia comercial (149 $/mes). Ver
# docs/external-apis.md antes de monetizar o de generar embeddings.
TMDB_API_KEY=

# IGDB vía Twitch. También solo uso no comercial (Twitch Developer Services
# Agreement); sus términos comerciales no publican precio.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Ranking-walk target per type: how far the sync_cursors cursor goes before
# wrapping back to 0.
# ⚠️ SEED_TOP_N_MOVIES and SEED_TOP_N_SERIES are INERT since feature 86 —
# movies and series are no longer enumerated by walking /movie/popular and
# /tv/popular. Their catalog is defined by TMDB_SEED_MIN_VOTES_* and
# enumerated into seed_targets by scripts/seed_tmdb_targets.py, so there is no
# item-count cutoff left to configure. Kept because Render and
# .github/workflows/backfill-sync.yml still export them. Only BOOKS and GAMES
# are live. See docs/seeding-plan.md §3.
SEED_TOP_N_MOVIES=100
SEED_TOP_N_SERIES=100
SEED_TOP_N_BOOKS=100
SEED_TOP_N_GAMES=100

# TMDB catalog definition (feature 86). The catalog is a quality threshold,
# not an item count: vote_count >= 25 yields 57.135 movies and 10.880 series
# (exact total_results measured against /discover on 2026-09-02). Per type so
# the two can be recalibrated independently; other measured thresholds are
# tabulated in docs/seeding-plan.md §2.1.
TMDB_SEED_MIN_VOTES_MOVIES=25
TMDB_SEED_MIN_VOTES_SERIES=25
# Release-year range the /discover enumeration slices over. 1874 is TMDB's
# oldest release year; leaving the end blank means "next year".
TMDB_SEED_START_YEAR=1874
# TMDB_SEED_END_YEAR=
# In-flight TMDB requests during seeding (enumeration pages and item
# hydration). TMDB documents ~50 req/s; 8 lands at ~32 (docs/seeding-plan.md §4).
TMDB_SEED_CONCURRENCY=8
# Conclusive hydration passes a seed target gets before it is retired from the
# work list as unlinkable. A failed request is not a pass, so a TMDB outage
# cannot retire a healthy target. This is what makes `pending` converge to 0 —
# and therefore what lets the last_synced_at refresh rotation run at all. The
# retired residue is reported separately as `stuck`. See docs/seeding-plan.md §3.
TMDB_SEED_MAX_ATTEMPTS=3

# Open Library seed quality filter (feature 73). The language fragments of the
# query are constants in backlogg/books/constants.py; only these thresholds
# are tunable. Defaults are the live-calibrated values (16.959 english +
# 1.858 spanish works) documented in docs/external-apis.md.
# BOOKS_SEED_MIN_READINGLOG: minimum readinglog_count for the english stream.
# BOOKS_SEED_MIN_READINGLOG_ES: same for the spanish stream — the shelving
#   signal is ~10x weaker in spanish, so a shared floor would seed 0 works.
# BOOKS_SEED_MIN_PAGES: minimum number_of_pages_median; drops pamphlets.
# BOOKS_SEED_MIN_EDITIONS: minimum edition_count for the english stream. This
#   is the notoriety filter: it drops loose comic instalments and video-game
#   tie-ins (0-3 editions) while keeping canonical graphic novels (11-66).
# BOOKS_SEED_MIN_EDITIONS_ES: same for the spanish stream. 2 and not 3 on
#   purpose — Reina roja has exactly 2 editions.
# BOOKS_SEED_ES_EVERY_N: one spanish work every N seeded slots (0 disables
#   the spanish stream).
BOOKS_SEED_MIN_READINGLOG=20
BOOKS_SEED_MIN_READINGLOG_ES=5
BOOKS_SEED_MIN_PAGES=100
BOOKS_SEED_MIN_EDITIONS=10
BOOKS_SEED_MIN_EDITIONS_ES=2
BOOKS_SEED_ES_EVERY_N=10

# Nightly sync slice. SYNC_SLICE_SIZE is the global fallback (200) and stays
# as-is; the four per-type overrides (feature 84) exist because the types have
# genuinely different needs — see docs/seeding-plan.md §2.3. Leave them unset
# to keep the current behaviour: an unset override falls back to
# SYNC_SLICE_SIZE, so this release changes nothing until they are filled in.
# Resolution order per job: explicit --slice-size argument (backfill script) ->
# SYNC_SLICE_SIZE_<TYPE> -> SYNC_SLICE_SIZE.
# Production targets for the seeding features (86-88), NOT applied by default:
#   SYNC_SLICE_SIZE_MOVIES=350  (57.135 movies re-synced inside TMDB's 6-month
#                                cache window = ~318/night, rounded up)
#   SYNC_SLICE_SIZE_SERIES=100  (10.880 series over 180 days = ~61/night)
SYNC_SLICE_SIZE=200
# SYNC_SLICE_SIZE_MOVIES=
# SYNC_SLICE_SIZE_SERIES=
# SYNC_SLICE_SIZE_BOOKS=
# SYNC_SLICE_SIZE_GAMES=

# How many items the batch write path (feature 84) writes per transaction.
# Bigger means fewer SQL round trips; smaller means less work to redo if a
# batch has to fall back to the per-item route.
#
# Upper bound — do NOT raise this past ~2.000 without reading the note in the
# docstring of backlogg/shared/bulk_load.py.  The batch route renders two
# lookup queries as `(source, external_id) IN ((?,?), ...)`, i.e. 2 bind
# parameters per key, and Postgres' wire protocol caps a statement at 32.767
# parameters.  At the ~7 credits/item this catalog averages that ceiling is
# hit around ~2.300 items per batch.  Crossing it does not corrupt anything:
# the batch raises and the caller reprocesses those items one by one — but
# that fallback is ~50x slower, and it is silent apart from a log line, so a
# too-large value turns a tuning knob into an invisible slowdown.
BULK_LOAD_BATCH_SIZE=500

SYNC_CRON=0 2 * * *

ADMIN_API_KEY=

# S3-compatible object storage, used for user avatar uploads
# (POST/DELETE /v1/users/me/avatar). Leave every R2_* var below empty in dev
# to get a controlled 503 instead of an unconfigured client failure.
#
# R2_ENDPOINT_URL selects the provider: empty -> real Cloudflare R2 (built
# from R2_ACCOUNT_ID, 10GB free tier, no egress fees); set -> any
# S3-compatible endpoint (MinIO in dev, Supabase Storage in prod). When
# R2_ENDPOINT_URL is set, R2_ACCOUNT_ID is not needed.
# R2_PUBLIC_BASE_URL is the public base objects are served from — no
# trailing slash.
R2_ENDPOINT_URL=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=

# Example — MinIO local (docker-compose.yml `minio` service), no card needed:
#   R2_ENDPOINT_URL=http://localhost:9000
#   R2_ACCESS_KEY_ID=minioadmin
#   R2_SECRET_ACCESS_KEY=minioadmin123
#   R2_BUCKET_NAME=avatars
#   R2_PUBLIC_BASE_URL=http://localhost:9000/avatars
#   (R2_ACCOUNT_ID not needed)
#
# Example — Supabase Storage in prod (S3-compatible, free tier, no card):
#   R2_ENDPOINT_URL=https://<project-ref>.supabase.co/storage/v1/s3
#   R2_ACCESS_KEY_ID=<S3 access key id, from Supabase Storage settings>
#   R2_SECRET_ACCESS_KEY=<S3 secret access key, from Supabase Storage settings>
#   R2_BUCKET_NAME=<your-supabase-bucket-name>
#   R2_PUBLIC_BASE_URL=https://<project-ref>.supabase.co/storage/v1/object/public/<bucket>
#   (R2_ACCOUNT_ID not needed)

JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# Account recovery (email verification + password reset).
# Leave SMTP_HOST empty in dev: the EmailSender logs the link instead of sending
# it. APP_BASE_URL is the public base used to build the email links.
# For Gmail testing: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_STARTTLS=true,
# SMTP_USERNAME/SMTP_FROM_EMAIL=<your-gmail>, SMTP_PASSWORD=<app-password> (2FA).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@backlogg.local
SMTP_STARTTLS=true
APP_BASE_URL=http://localhost:3000
EMAIL_VERIFY_EXPIRE_HOURS=24
PASSWORD_RESET_EXPIRE_HOURS=1

# Rate limiting — format "count/seconds" (e.g. 10/60 = 10 hits per 60s).
# RATE_LIMIT_AUTH: per-IP limit on POST /auth/login and /auth/register.
# RATE_LIMIT_SEARCH_FALLBACK: per-IP limit on the external fan-out of /search.
# RATE_LIMIT_DEFAULT: general-purpose bucket reusable by the limiter interface.
RATE_LIMIT_AUTH=10/60
RATE_LIMIT_DEFAULT=120/60
RATE_LIMIT_SEARCH_FALLBACK=20/60

# Observability — structured JSON logging + optional Sentry.
# LOG_LEVEL: root log level (DEBUG/INFO/WARNING/ERROR). Logs are emitted as JSON
#   lines with a request_id for correlation; sensitive fields are always redacted.
# SENTRY_DSN: leave empty to disable error tracking entirely (no overhead, the
#   sentry-sdk package is never even imported). Set it to enable Sentry.
LOG_LEVEL=INFO
SENTRY_DSN=

# Response caching — Cache-Control/ETag on reads + in-process TTL cache for the
# expensive /trending and /genres reads (all seconds).
# CACHE_CONTROL_DETAIL_MAX_AGE: max-age advertised for anonymous detail reads.
# CACHE_CONTROL_LISTING_MAX_AGE: max-age for catalog listings.
# CACHE_TTL_TRENDING / CACHE_TTL_GENRES: TTL of the in-process cache (behind a
#   swappable interface, movable to Redis) for those aggregate reads.
CACHE_CONTROL_DETAIL_MAX_AGE=300
CACHE_CONTROL_LISTING_MAX_AGE=60
CACHE_TTL_TRENDING=900
CACHE_TTL_GENRES=300
